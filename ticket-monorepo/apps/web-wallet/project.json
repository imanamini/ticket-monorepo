{
  "name": "web-wallet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web-wallet/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/web-wallet",
        "index": "apps/web-wallet/src/index.html",
        "main": "apps/web-wallet/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/web-wallet/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/web-wallet/src/favicon.ico",
          "apps/web-wallet/src/assets"
        ],
        "styles": [
          "apps/web-wallet/src/styles.scss",
          "./node_modules/@digipay/base-style/styleguide-theme.scss"
        ],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": ["./"]
        },
        "sourceMap": true
      },
      "configurations": {
        "production": {
          "optimization": true,
          "sourceMap": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/web-wallet/src/environments/environment.ts",
              "with": "apps/web-wallet/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "web-wallet:build:production"
        },
        "development": {
          "buildTarget": "web-wallet:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/web-wallet/src/**/*.ts", "apps/web-wallet/src/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web-wallet/jest.config.ts"
      }
    }
  }
}
