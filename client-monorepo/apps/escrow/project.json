{
  "name": "escrow",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/escrow/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/escrow",
        "index": "apps/escrow/src/index.html",
        "browser": "apps/escrow/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/escrow/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/escrow/src/favicon.ico",
          "apps/escrow/src/assets",
          "apps/escrow/src/manifest.stg.webmanifest",
          "apps/escrow/src/manifest.webmanifest"
        ],
        "styles": [
          "apps/escrow/src/styles.scss",
          "./node_modules/@digipay/base-style/styleguide-theme.scss",
          "libs/shared/common/assets/src/lib/styles/globals.scss"
        ],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": [
            "./node_modules/@digipay",
            "./libs/shared/common/assets/src/lib"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/escrow/src/environments/environment.ts",
              "with": "apps/escrow/src/environments/environment.prod.ts"
            }
          ],
          "index": {
            "input": "apps/escrow/src/index.prod.html",
            "output": "index.html"
          },
          "define": {
            "process.env.name": "'production'"
          },
          "serviceWorker": "apps/escrow/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "process.env.name": "'development'"
          },
          "fileReplacements": [
            {
              "replace": "apps/escrow/src/environments/environment.ts",
              "with": "apps/escrow/src/environments/environment.dev.ts"
            }
          ],
          "index": {
            "input": "apps/escrow/src/index.dev.html",
            "output": "index.html"
          }
        },
        "staging": {
          "optimization": true,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "process.env.name": "'staging'"
          },
          "fileReplacements": [
            {
              "replace": "apps/escrow/src/environments/environment.ts",
              "with": "apps/escrow/src/environments/environment.stg.ts"
            }
          ],
          "index": {
            "input": "apps/escrow/src/index.stg.html",
            "output": "index.html"
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/escrow/ngsw-config.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "escrow:build:production"
        },
        "development": {
          "buildTarget": "escrow:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "escrow:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/escrow/src/**/*.ts"
        ]
      },
      "eslintConfig": ".eslintrc.json"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/escrow/jest.config.ts"
      }
    }
  }
}
