{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "cacheQueryOptions": {
        "ignoreSearch": false
      },
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/main*.js",
          "/polyfills*.js",
          "/styles*.css"
        ]
      }
    },
    {
      "name": "lazy-chunks",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/chunk-*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/**", "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|mp4|webm|ogg|mov)"]
      }
    }
  ],
  "appData": {
    "version": "1.0.5",
    "name": "pillar"
  },
  "dataGroups": [
    {
      "name": "index-html",
      "urls": ["/index.html"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "5m",
        "timeout": "2s"
      }
    },
    {
      "name": "api-images-pillar",
      "urls": ["/digipay/api/files/**"],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "8h",
        "strategy": "performance",
        "timeout": "10s"
      }
    }
  ]
}
