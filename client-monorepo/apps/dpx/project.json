{
  "name": "dpx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/dpx/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dpx",
        "index": "apps/dpx/src/index.html",
        "browser": "apps/dpx/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dpx/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/dpx/src/favicon.ico",
          "apps/dpx/src/assets",
          "apps/dpx/src/manifest.stg.webmanifest",
          "apps/dpx/src/manifest.webmanifest",
          "apps/dpx/src/.well-known",
          "apps/dpx/src/resolver.html",
          "apps/dpx/src/form-resolver.html",
          {
            "input": "libs/applets/wealth/src/lib/assets/",
            "output": "wealth-assets",
            "glob": "**/*"
          },
          {
            "input": "libs/applets/insurance/src/lib/assets/",
            "output": "insurance-assets",
            "glob": "**/*"
          },
          {
            "input": "libs/applets/credit/src/lib/features/credit/assets/",
            "output": "credit-assets",
            "glob": "**/*"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/common/assets/src/lib/public-assets",
            "output": "assets/shared"
          }
        ],
        "styles": [
          "apps/dpx/src/styles.scss",
          "./node_modules/@digipay/base-style/styleguide-theme.scss",
          "./node_modules/leaflet/dist/leaflet.css",
          "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
          "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
          "libs/shared/common/assets/src/lib/styles/globals.scss"
        ],
        "scripts": [
          "./node_modules/leaflet/dist/leaflet.js",
          "./node_modules/leaflet.markercluster/dist/leaflet.markercluster.js",
          "./apps/dpx/src/assets/js/finisher-header.es5.min.js"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["./node_modules/@digipay", "libs/shared/common/assets/src/lib", "libs/applets"]
        }
      },
      "configurations": {
        "production": {
          "sourceMap": {
            "scripts": true,
            "styles": false
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "8mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/dpx/src/environments/environment.ts",
              "with": "apps/dpx/src/environments/environment.prod.ts"
            }
          ],
          "index": {
            "input": "apps/dpx/src/index.prod.html",
            "output": "index.html"
          },
          "define": {
            "process.env.name": "'production'",
            "process.env.base_url": "'https://api.mydigipay.com/digipay/api'"
          },
          "serviceWorker": "apps/dpx/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": {
            "scripts": true,
            "styles": false
          },
          "define": {
            "process.env.name": "'development'",
            "process.env.base_url": "'https://uat.mydigipay.info/digipay/api'"
          },
          "fileReplacements": [
            {
              "replace": "apps/dpx/src/environments/environment.ts",
              "with": "apps/dpx/src/environments/environment.dev.ts"
            }
          ],
          "index": {
            "input": "apps/dpx/src/index.dev.html",
            "output": "index.html"
          }
        },
        "staging": {
          "optimization": true,
          "extractLicenses": false,
          "sourceMap": {
            "scripts": true,
            "styles": false
          },
          "define": {
            "process.env.name": "'staging'",
            "process.env.base_url": "'https://uat.mydigipay.info/digipay/api'"
          },
          "fileReplacements": [
            {
              "replace": "apps/dpx/src/environments/environment.ts",
              "with": "apps/dpx/src/environments/environment.stg.ts"
            }
          ],
          "index": {
            "input": "apps/dpx/src/index.stg.html",
            "output": "index.html"
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "8mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/dpx/ngsw-config.json"
        }

      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dpx:build:production"
        },
        "development": {
          "buildTarget": "dpx:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "dpx:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/dpx/src/**/*.ts"]
      },
      "eslintConfig": ".eslintrc.json"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/dpx/jest.config.ts"
      }
    },
    "analyze": {
      "executor": "@nx/esbuild:esbuild",
      "options": {
        "platform": "browser",
        "outputPath": "dist/analyze/dpx",
        "main": "apps/dpx/src/main.ts",
        "tsConfig": "apps/dpx/tsconfig.app.json",
        "bundle": true,
        "metafile": true
      }
    },
    "analyze:visualize": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node generate-analysis.js"
      }
    }
  }
}
