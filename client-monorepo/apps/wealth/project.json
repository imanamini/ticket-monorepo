{
  "name": "wealth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/wealth/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/wealth",
        "index": "apps/wealth/src/index.html",
        "browser": "apps/wealth/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/wealth/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/wealth/src/favicon.ico",
          "apps/wealth/src/assets",
          "apps/wealth/src/manifest.stg.webmanifest",
          "apps/wealth/src/manifest.webmanifest",
          {
            "input": "libs/applets/wealth/src/lib/assets/",
            "output": "wealth-assets",
            "glob": "**/*"
          }
        ],
        "styles": [
          "./node_modules/@digipay/base-style/styleguide-theme.scss",
          "libs/applets/wealth/src/lib/shared/styles/styles.scss"
        ],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": [
            "./node_modules/@digipay",
            "./libs/shared/common/assets/src/lib"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "libs/applets/wealth/src/lib/data-access/environments/environment.ts",
              "with": "libs/applets/wealth/src/lib/data-access/environments/environment.w.prod.ts"
            }
          ],
          "index": {
            "input": "apps/wealth/src/index.prod.html",
            "output": "index.html"
          },
          "define": {
            "process.env.name": "'production'"
          },
          "serviceWorker": "apps/wealth/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "process.env.name": "'development'"
          },
          "fileReplacements": [
            {
              "replace": "libs/applets/wealth/src/lib/data-access/environments/environment.ts",
              "with": "libs/applets/wealth/src/lib/data-access/environments/environment.w.dev.ts"
            }
          ],
          "index": {
            "input": "apps/wealth/src/index.dev.html",
            "output": "index.html"
          }
        },
        "staging": {
          "optimization": true,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "process.env.name": "'staging'"
          },
          "fileReplacements": [
            {
              "replace": "libs/applets/wealth/src/lib/data-access/environments/environment.ts",
              "with": "libs/applets/wealth/src/lib/data-access/environments/environment.w.stg.ts"
            }
          ],
          "index": {
            "input": "apps/wealth/src/index.stg.html",
            "output": "index.html"
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/wealth/ngsw-config.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "wealth:build:production"
        },
        "development": {
          "buildTarget": "wealth:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "wealth:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/wealth/src/**/*.ts"]
      },
      "eslintConfig": ".eslintrc.json"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/wealth/jest.config.ts"
      }
    }
  }
}
